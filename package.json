{
  "name": "@matthbish/git-toolbox",
  "version": "1.0.0",
  "description": "Everyday git workflow shortcuts: push, pull, amend, squash, clean up branches, export diffs, and find added TODOs — as one small CLI.",
  "keywords": [
    "git",
    "cli",
    "developer-tools",
    "productivity",
    "workflow"
  ],
  "homepage": "https://github.com/matthbish/git-toolbox#readme",
  "bugs": "https://github.com/matthbish/git-toolbox/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matthbish/git-toolbox.git"
  },
  "license": "MIT",
  "author": "Matthew Bishop",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "git-toolbox": "dist/index.js"
  },
  "files": [
    "dist",
    "scripts"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish",
    "prepublishOnly": "npm run build",
    "postinstall": "node scripts/postinstall.mjs",
    "preuninstall": "node scripts/preuninstall.mjs"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@eslint/js": "^9.15.0",
    "@types/node": "^20.19.43",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^3.2.7"
  }
}
